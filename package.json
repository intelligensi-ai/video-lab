{
  "name": "intelligensi-video-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "apps/api/dist/index.js",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:emulators": "firebase emulators:start --project demo-video-lab",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "openapi:lint": "redocly lint contracts/video-lab.openapi.yaml",
    "openapi:generate": "openapi-typescript contracts/video-lab.openapi.yaml -o packages/contracts/src/generated.ts",
    "build": "pnpm openapi:generate && tsc -b && pnpm -r build",
    "contract:test": "vitest run tests/contract"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "2.38.0",
    "@rolldown/binding-darwin-arm64": "^1.2.0",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.7.0",
    "firebase-tools": "15.23.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "@google-cloud/functions-framework": "^5.0.5",
    "@tanstack/react-query": "5.101.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "firebase": "12.16.0",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5",
    "nanoid": "6.0.0",
    "openapi3-ts": "4.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-router": "8.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "fast-xml-parser": "5.10.1",
      "uuid": "11.1.1"
    }
  }
}

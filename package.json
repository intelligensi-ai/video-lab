{
  "name": "intelligensi-video-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:emulators": "firebase emulators:start --project demo-video-lab",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "openapi:lint": "redocly lint contracts/video-lab.openapi.yaml",
    "openapi:generate": "openapi-typescript contracts/video-lab.openapi.yaml -o packages/contracts/src/generated.ts",
    "build": "pnpm openapi:generate && tsc -b && pnpm -r build",
    "contract:test": "vitest run tests/contract"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@redocly/cli": "latest",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "firebase-tools": "latest",
    "openapi-typescript": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "supertest": "latest",
    "@types/supertest": "latest",
    "yaml": "latest"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "latest",
    "@firebase/rules-unit-testing": "latest",
    "@tanstack/react-query": "latest",
    "ajv": "latest",
    "ajv-formats": "latest",
    "cors": "latest",
    "express": "latest",
    "firebase": "latest",
    "firebase-admin": "latest",
    "firebase-functions": "latest",
    "nanoid": "latest",
    "openapi3-ts": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router-dom": "latest",
    "swagger-ui-express": "latest",
    "zod": "latest"
  }
}
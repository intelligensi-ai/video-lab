# Copy to a secret manager or runtime environment; do not commit real values.
VIDEO_RUNTIME_PROVIDER=sulphur-ltx

# Public or private HTTPS origin for the Deploy Studio runtime facade.
# Prefer a stable DNS name in front of the Lambda Labs instance.
VIDEO_RUNTIME_BASE_URL=https://ltx-runtime.example.intelligensi.ai

# Keep this server-side only. In Firebase use:
# firebase functions:secrets:set VIDEO_RUNTIME_API_TOKEN --project <project-id>
VIDEO_RUNTIME_API_TOKEN=replace-me

# Defaults match the runtime adapter. Override these if Deploy Studio exposes
# different paths.
VIDEO_RUNTIME_HEALTH_PATH=/health
VIDEO_RUNTIME_SUBMIT_PATH=/generations
VIDEO_RUNTIME_STATUS_PATH=/generations/{jobId}
VIDEO_RUNTIME_CANCEL_PATH=/generations/{jobId}/cancel
VIDEO_RUNTIME_OUTPUT_PATH=/generations/{jobId}/output

# Auth defaults to: Authorization: Bearer <token>
VIDEO_RUNTIME_AUTH_HEADER=authorization
VIDEO_RUNTIME_AUTH_SCHEME=Bearer

# Use "deploy-studio" if the instance expects prompt/settings/inputAssetUrls.
# Use "sulphur" for prompt/options/inputAssetUrls.
VIDEO_RUNTIME_PAYLOAD_MODE=deploy-studio
VIDEO_RUNTIME_TIMEOUT_MS=120000

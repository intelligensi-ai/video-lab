# Copy to a secret manager or runtime environment; do not commit real values.

# Preferred production boundary: the stable API documented by Deploy Studio at
# docs/intelligensi-runtime-api.openapi.yaml. Video Lab never receives a Lambda
# instance origin and does not read Deploy Studio's private runtime lease.
VIDEO_RUNTIME_PROVIDER=intelligensi-api
VIDEO_RUNTIME_BASE_URL=https://api.intelligensi.ai
VIDEO_RUNTIME_ID=longform-ltx-storyboard-studio

# Keep this key server-side only. It must match Deploy Studio's
# VIDEO_LAB_RUNTIME_API_KEY. It is not the Lambda Cloud API key. In Firebase use
# the platform secret manager.
VIDEO_LAB_RUNTIME_API_KEY=replace-me
# Backward-compatible Video Lab alias; prefer VIDEO_LAB_RUNTIME_API_KEY.
VIDEO_RUNTIME_API_TOKEN=

# These are the contract defaults and normally do not need overriding.
VIDEO_RUNTIME_PAYLOAD_MODE=intelligensi-api
VIDEO_RUNTIME_AUTH_HEADER=X-Intelligensi-API-Key
VIDEO_RUNTIME_AUTH_SCHEME=none
VIDEO_RUNTIME_TIMEOUT_MS=120000
VIDEO_RUNTIME_JOB_TIMEOUT_MS=3300000
VIDEO_STORYBOARD_ENHANCER_TIMEOUT_MS=250000

# Direct-worker migration fallback only. Do not use this for new production
# deployments; it bypasses the stable Deploy Studio API contract.
# VIDEO_RUNTIME_PROVIDER=sulphur-ltx
# VIDEO_RUNTIME_BASE_URL=https://temporary-worker.example.intelligensi.ai
# VIDEO_RUNTIME_PAYLOAD_MODE=deploy-studio
# VIDEO_RUNTIME_HEALTH_PATH=/health
# VIDEO_RUNTIME_SUBMIT_PATH=/jobs
# VIDEO_RUNTIME_STATUS_PATH=/jobs/{jobId}
# VIDEO_RUNTIME_CANCEL_PATH=/jobs/{jobId}/cancel
# VIDEO_RUNTIME_OUTPUT_PATH=/jobs/{jobId}/output
# VIDEO_RUNTIME_DIRECT_WORKER_TOKEN=replace-with-runtime-access-token
# VIDEO_RUNTIME_DIRECT_WORKER_AUTH_HEADER=authorization
# VIDEO_RUNTIME_DIRECT_WORKER_AUTH_SCHEME=Bearer

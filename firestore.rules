rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function preservesRoles() {
      return (!('roles' in resource.data) && !('roles' in request.resource.data))
        || (('roles' in resource.data) && request.resource.data.roles == resource.data.roles);
    }
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && !('roles' in request.resource.data);
      allow update: if isOwner(uid) && request.resource.data.uid == uid && preservesRoles();
      allow delete: if false;
    }
    // API-managed records may contain internal object paths or runtime metadata.
    // They are returned only through the authenticated same-origin gateway.
    match /creditWallets/{uid} { allow read, write: if false; }
    match /creditLedger/{id} { allow read, write: if false; }
    match /generations/{id} { allow read, write: if false; }
    match /assets/{id} { allow read, write: if false; }
    match /storyboardDrafts/{uid} { allow read, write: if false; }
    match /storyboardProjects/{id} { allow read, write: if false; }
    match /projectDeletionQueue/{id} { allow read, write: if false; }
    match /runtimeState/{id} { allow read, write: if false; }
    match /runtimeDiscovery/{id} { allow read, write: if false; }
    match /queue/{id} { allow read, write: if false; }
    match /generationQueue/{id} { allow read, write: if false; }
    match /generationIdempotency/{id} { allow read, write: if false; }
    match /generationActive/{id} { allow read, write: if false; }
    match /adminAudit/{id} { allow read, write: if false; }
    match /systemMetrics/{id} { allow read, write: if false; }
  }
}

VIDEO_RUNTIME_PROVIDER=mock
# Production gateway configuration:
# VIDEO_RUNTIME_PROVIDER=intelligensi-api
# VIDEO_RUNTIME_BASE_URL=https://api.intelligensi.ai
VIDEO_RUNTIME_BASE_URL=
# Dedicated Deploy Studio runtime-gateway credential; never use LAMBDA_API_KEY.
VIDEO_LAB_RUNTIME_API_KEY=
# Backward-compatible alias; prefer VIDEO_LAB_RUNTIME_API_KEY.
VIDEO_RUNTIME_API_TOKEN=
VIDEO_RUNTIME_ID=longform-ltx-storyboard-studio
VIDEO_RUNTIME_MAX_CONCURRENCY=1
# Production gateway mode. Direct worker modes are migration/local fallback only.
VIDEO_RUNTIME_PAYLOAD_MODE=deploy-studio
VIDEO_RUNTIME_STORYBOARD_ENHANCE_PATH=
VIDEO_RUNTIME_ALLOWED_ORIGINS=
VIDEO_RUNTIME_ALLOW_ENV_FALLBACK=false
VIDEO_RUNTIME_DISCOVERY_COLLECTION=runtimeDiscovery
VIDEO_RUNTIME_DISCOVERY_DOCUMENT=longform-ltx-storyboard-studio
VIDEO_RUNTIME_DISCOVERY_REFRESH_MS=10000
VIDEO_RUNTIME_JOB_TIMEOUT_MS=3300000
VIDEO_RUNTIME_GLOBAL_QUEUE_LIMIT=100
# Bounded number of Video Lab queue claims that may dispatch concurrently.
# Each managed GPU worker still accepts one VRAM-intensive render at a time.
VIDEO_LAB_WORKER_CONCURRENCY=2
# Maximum size of one accepted scene clip supplied to cross-worker assembly.
VIDEO_LAB_ASSEMBLY_SOURCE_MAX_BYTES=167772160
# Maximum queue attempts for rebuilding an assembly after its runtime lease is
# replaced. The API constrains this value to 1-5; the default is 3.
VIDEO_LAB_ASSEMBLY_RECOVERY_ATTEMPTS=3
VIDEO_DEPLOY_STUDIO_BASE_URL=
VIDEO_DEPLOY_STUDIO_API_TOKEN=
VIDEO_DEPLOY_STUDIO_STORYBOARD_ENHANCE_PATH=/api/storyboards/enhance
VIDEO_DEPLOY_STUDIO_AUTH_HEADER=
VIDEO_DEPLOY_STUDIO_AUTH_SCHEME=
VIDEO_STORYBOARD_ENHANCER_PROVIDER=deploy-studio
VIDEO_STORYBOARD_ENHANCER_TIMEOUT_MS=250000
DIRECTOR_MEMORY_ENABLED=false
DIRECTOR_MEMORY_BASE_URL=
# Supply from Secret Manager in deployed environments; do not commit a real token.
DIRECTOR_MEMORY_API_TOKEN=
DIRECTOR_MEMORY_RETRIEVAL_LIMIT=6
DIRECTOR_MEMORY_TIMEOUT_MS=2500
DIRECTOR_MEMORY_WRITE_CANDIDATES=false
DIRECTOR_MEMORY_REQUIRE_RETRIEVAL=false
# Durable browser-facing Director queue. Firebase Hosting requests remain short;
# the Cloud Tasks worker owns the long internal Gemma request.
VIDEO_STORYBOARD_ASYNC_QUEUE_LIMIT=50
VIDEO_STORYBOARD_ASYNC_LEASE_MS=720000
VIDEO_LAB_ALLOWED_ORIGINS=
VIDEO_LAB_RATE_LIMIT_PER_MINUTE=180
VIDEO_LAB_JSON_LIMIT=16mb
VIDEO_LAB_WORKER_TOKEN=
VIDEO_LAB_LOCAL_AUTH=true
# Production defaults to Firestore-backed, fail-closed entitlements. Use the
# staging allow-list only for a time-bounded acceptance deployment.
VIDEO_LAB_ENTITLEMENT_MODE=firestore
VIDEO_LAB_ENTITLEMENT_POLICY_VERSION=staging-2026-08
VIDEO_LAB_STAGING_UIDS=
# Optional defence in depth. Configure the matching Firebase web provider before
# enabling; Firebase ID-token verification remains mandatory either way.
VIDEO_LAB_APP_CHECK_REQUIRED=false
ADMIN_EMAILS=
FREE_TRIAL_CREDITS=12
CREDIT_LIMITS_ENABLED=false
GENERATION_BASE_COST=4
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-video-lab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-video-lab
VITE_USE_FIREBASE_EMULATORS=true
VITE_ENABLE_DEMO_API=false

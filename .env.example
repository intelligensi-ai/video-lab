VIDEO_RUNTIME_PROVIDER=mock
# Production gateway configuration:
# VIDEO_RUNTIME_PROVIDER=intelligensi-api
# VIDEO_RUNTIME_BASE_URL=https://api.intelligensi.ai
VIDEO_RUNTIME_BASE_URL=
# Dedicated Deploy Studio runtime-gateway credential; never use LAMBDA_API_KEY.
VIDEO_RUNTIME_API_TOKEN=
VIDEO_RUNTIME_ID=longform-ltx-storyboard-studio
VIDEO_RUNTIME_MAX_CONCURRENCY=1
# Production gateway mode. Direct worker modes are migration/local fallback only.
VIDEO_RUNTIME_PAYLOAD_MODE=deploy-studio
VIDEO_RUNTIME_STORYBOARD_ENHANCE_PATH=
VIDEO_RUNTIME_ALLOWED_ORIGINS=
VIDEO_RUNTIME_ALLOW_ENV_FALLBACK=false
VIDEO_RUNTIME_DISCOVERY_COLLECTION=runtimeDiscovery
VIDEO_RUNTIME_DISCOVERY_DOCUMENT=longform-ltx-storyboard-studio
VIDEO_RUNTIME_DISCOVERY_REFRESH_MS=10000
VIDEO_RUNTIME_JOB_TIMEOUT_MS=3300000
VIDEO_RUNTIME_GLOBAL_QUEUE_LIMIT=100
VIDEO_DEPLOY_STUDIO_BASE_URL=
VIDEO_DEPLOY_STUDIO_API_TOKEN=
VIDEO_DEPLOY_STUDIO_STORYBOARD_ENHANCE_PATH=/api/storyboards/enhance
VIDEO_STORYBOARD_ENHANCER_PROVIDER=deploy-studio
VIDEO_STORYBOARD_ENHANCER_TIMEOUT_MS=100000
VIDEO_LAB_ALLOWED_ORIGINS=
VIDEO_LAB_RATE_LIMIT_PER_MINUTE=180
VIDEO_LAB_JSON_LIMIT=16mb
VIDEO_LAB_WORKER_TOKEN=
ADMIN_EMAILS=
FREE_TRIAL_CREDITS=12
CREDIT_LIMITS_ENABLED=false
GENERATION_BASE_COST=4
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-video-lab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-video-lab
VITE_USE_FIREBASE_EMULATORS=true
VITE_ENABLE_DEMO_API=false
